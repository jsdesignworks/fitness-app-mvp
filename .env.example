# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# AI Provider Configuration
# Options: 'anthropic' or 'openai'
AI_PROVIDER=anthropic

# Anthropic (Claude) API Key
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API Key (optional, for future use)
# OPENAI_API_KEY=your-openai-api-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Fitness Tracker
NODE_ENV=development

# License & Security
# Generate with: openssl rand -base64 32
LICENSE_ENCRYPTION_KEY=your-license-encryption-key-here

# Rate Limiting
RATE_LIMIT_AI_CHAT_PER_HOUR=30
RATE_LIMIT_AI_RECOMMENDATIONS_PER_DAY=10
RATE_LIMIT_API_PER_MINUTE=60

# External Integrations (Optional for MVP)

# Google Calendar Integration
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Barcode API for nutrition (optional)
# BARCODE_API_KEY=your-barcode-api-key

# Email (for notifications, optional)
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourapp.com

# Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# SENTRY_DSN=your-sentry-dsn

# Feature Flags (optional)
# ENABLE_CALENDAR_SYNC=true
# ENABLE_BARCODE_SCANNING=false
# ENABLE_PUSH_NOTIFICATIONS=false

# PWA — register minimal static-asset service worker in dev (production registers by default)
# NEXT_PUBLIC_ENABLE_PWA_SW=true
